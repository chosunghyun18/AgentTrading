# 복사해서 .env 로 쓴다(.env 는 커밋 금지). 출금 권한 없는 키만 쓴다.
# Bybit Demo Trading API 키 (모의 자금)
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Bybit 메인넷 서브계정 API 키 (실제 자금) — 넣고 AT_LIVE_ENABLED=1 이어야 LIVE 전환 가능
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=
AT_LIVE_ENABLED=0
# 시세(1분봉) 소스 — parquet(기본, data/raw/normalized/bitmex) 또는 db. 판정 경로는 늘 parquet.
# 서버: AT_ENV=dev|prod 이면 db 필수 + DB 이름이 _dev|_prod 로 끝나야 한다. 적재: python -m src.marketdata.sync
AT_ENV=local
AT_MARKET_SOURCE=parquet
AT_MARKET_DB_URL=
