# 가상환경
.venv/

# 원본 거래 기록 — 용량/저작권 문제로 커밋하지 않는다
data/raw/*
!data/raw/.gitkeep

# 분석 산출물
data/out/

# 설정 실값
config/config.yaml

# work repo 루트 .gitignore의 `shared/` (MiroFishTrader 런타임 폴더용) 예외 —
# AgentTrading의 src/shared 는 소스 코드다.
!src/shared/

# 파이프라인 실행 로그
data/logs/

# 공통 (work 레포 루트에서 옮겨옴)
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.env

# 트레이딩 콘솔 상태(감사 로그·정지 플래그·모드)·리스크 한도 — 사용자 값, 커밋 금지
data/agent/
config/risk.yaml
